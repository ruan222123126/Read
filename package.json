{
  "name": "read",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/web\" --filter \"./packages/*\" dev",
    "dev:web": "pnpm --filter @read/web dev",
    "dev:lan": "pnpm --filter @read/web dev:lan",
    "dev:api": "cargo run --manifest-path apps/api/Cargo.toml -p read-server",
    "build": "pnpm --filter @read/web build",
    "build:api": "cargo build --release --manifest-path apps/api/Cargo.toml",
    "lint": "pnpm --filter @read/web lint && cargo clippy --manifest-path apps/api/Cargo.toml --all-targets -- -D warnings",
    "typecheck": "pnpm --filter @read/web typecheck",
    "test": "pnpm --filter @read/web test && cargo test --manifest-path apps/api/Cargo.toml",
    "fmt": "cargo fmt --manifest-path apps/api/Cargo.toml && pnpm --filter @read/web format",
    "db:up": "docker compose up -d postgres redis minio",
    "db:down": "docker compose down",
    "db:migrate": "sqlx migrate run --source apps/api/migrations"
  },
  "devDependencies": {
    "prettier": "^3.4.2"
  }
}
