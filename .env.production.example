# ============================================================
# 生产环境变量模板。复制为 .env（放在仓库根目录，与
# docker-compose.prod.yml 同目录）后逐项修改，切勿提交真实 .env。
#   cp .env.production.example .env
# ============================================================

# ===== 必填 =====
# 数据库密码：换成强随机值，例如
#   openssl rand -base64 24
POSTGRES_PASSWORD=change_me_strong_password

# MinIO 管理凭据（封面、字体子集等对象存储）
MINIO_ROOT_USER=readminio
MINIO_ROOT_PASSWORD=change_me_strong_password_too

# ===== 可选 =====
# web 对外端口：直接用 http://服务器IP:3000 访问时改这里
WEB_PORT=3000

# 日志级别：info | debug | trace
RUST_LOG=read_server=info,tower_http=info

# ===== 用 Caddy 自动 HTTPS 时才填 =====
# 域名的 A 记录先解析到服务器 IP，然后启动时加 --profile tls
# DOMAIN=read.example.com
