# ===== Rust API =====
# 监听地址
APP__HOST=0.0.0.0
APP__PORT=8080
# info | debug | trace
RUST_LOG=read_server=debug,tower_http=debug,info

# ===== PostgreSQL =====
DATABASE_URL=postgres://read:read_dev_password@localhost:5432/read

# ===== Redis（抓取队列 / 限流）=====
REDIS_URL=redis://localhost:6379

# ===== MinIO / S3（封面、字体子集）=====
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=read-assets
S3_ACCESS_KEY=readminio
S3_SECRET_KEY=readminio123

# ===== Web =====
# 前端访问后端的基地址
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
