# ===== Rust API =====
# 监听地址。0.0.0.0 表示同时接收本机和局域网（手机）请求
APP__HOST=0.0.0.0
APP__PORT=8080
# info | debug | trace
RUST_LOG=read_server=debug,tower_http=debug,info

# ===== PostgreSQL =====
DATABASE_URL=postgres://read:read_dev_password@localhost:5432/read

# ===== Redis（抓取队列 / 限流）=====
REDIS_URL=redis://localhost:6379

# ===== MinIO / S3（封面、字体子集）=====
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=read-assets
S3_ACCESS_KEY=readminio
S3_SECRET_KEY=readminio123

# ===== Web =====
# Next.js 服务端反代目标（浏览器一律走同源 /backend）
API_INTERNAL_URL=http://127.0.0.1:8080
# 如需让浏览器直连 API（比如前端单独部署），才设置下面这项；
# 留空则使用同源 /backend，手机访问 http://<电脑IP>:3000 自动可用。
# NEXT_PUBLIC_API_BASE_URL=http://192.168.1.10:8080
